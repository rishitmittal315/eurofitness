    "install-all": "npm install && cd frontend && npm install && cd ..",
    "build": "cd frontend && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "concurrently": "^7.6.0"
  },
  "devDependencies": {},
  "keywords": [
    "fitness",
    "gym",
    "3d",
    "training",
    "diet",
    "react",
    "nodejs"
  ],
