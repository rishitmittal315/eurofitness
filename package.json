{
  "name": "eurofitness",
  "version": "1.0.0",
  "description": "3D Gym Website with Admin Panel, Payment System, and Membership Plans",
  "main": "index.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "client": "cd frontend && npm start",
    "server": "node backend/server.js",
    "build": "cd frontend && npm run build",
    "install-all": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "stripe": "^11.15.0",
    "nodemailer": "^6.9.1",
    "concurrently": "^7.6.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
