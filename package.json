{
  "name": "eurofitness-root",
  "version": "1.0.0",
  "description": "EuroFitness - 3D Gym Website",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd frontend && npm start",
